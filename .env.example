# Fastify API deployed to Vercel: https://fastify-api-xi.vercel.app/
# Replace with your own vercel deployment URL and Neon database connection string
DATABASE_URL="xxxx"

# Optional pool tuning (used later when you register @fastify/postgres)
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# Server / Vercel
PORT=3000
NODE_ENV=development
DATABASE_URL_UNPOOLED="xxxx"
NEON_BRANCH=production
JWT_SECRET="xxxx"